#version 450
layout(local_size_x=8,local_size_y=8) in;
layout(set=0,binding=0) uniform sampler2D inputImage;
layout(set=0,binding=1,rgba8) writeonly uniform image2D outputImage;
float Luma(vec3 rgb) { return dot(rgb,vec3(0.299,0.587,0.114)); }
void main() {
    const ivec2 pixel=ivec2(gl_GlobalInvocationID.xy);
    const ivec2 size=imageSize(outputImage);
    if(any(greaterThanEqual(pixel,size))) return;
    const vec2 step=1.0/vec2(size);
    const vec2 uv=(vec2(pixel)+0.5)*step;
    const vec4 centre=textureLod(inputImage,uv,0.0);
    const float m=Luma(centre.rgb);
    const float nw=Luma(textureLod(inputImage,uv+vec2(-1,-1)*step,0.0).rgb);
    const float ne=Luma(textureLod(inputImage,uv+vec2(1,-1)*step,0.0).rgb);
    const float sw=Luma(textureLod(inputImage,uv+vec2(-1,1)*step,0.0).rgb);
    const float se=Luma(textureLod(inputImage,uv+vec2(1,1)*step,0.0).rgb);
    const float low=min(m,min(min(nw,ne),min(sw,se)));
    const float high=max(m,max(max(nw,ne),max(sw,se)));
    if(high-low<max(0.0625,high*0.125)) { imageStore(outputImage,pixel,centre); return; }
    vec2 dir=vec2(-((nw+ne)-(sw+se)),(nw+sw)-(ne+se));
    const float reduce=max((nw+ne+sw+se)*0.03125,0.0078125);
    dir=clamp(dir/(min(abs(dir.x),abs(dir.y))+reduce),vec2(-8),vec2(8))*step;
    const vec3 a=0.5*(textureLod(inputImage,uv+dir*(-1.0/6.0),0.0).rgb+
                      textureLod(inputImage,uv+dir*(1.0/6.0),0.0).rgb);
    const vec3 b=a*0.5+0.25*(textureLod(inputImage,uv-dir*0.5,0.0).rgb+
                             textureLod(inputImage,uv+dir*0.5,0.0).rgb);
    const float lb=Luma(b);
    imageStore(outputImage,pixel,vec4(lb<low||lb>high ? a : b,centre.a));
}
