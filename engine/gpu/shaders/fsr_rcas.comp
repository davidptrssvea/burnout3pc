#version 450
#extension GL_GOOGLE_include_directive : require
#define A_GPU 1
#define A_GLSL 1
#include "fsr/ffx_a.h"
layout(local_size_x=8,local_size_y=8) in;
layout(binding=0) uniform sampler2D sourceImage;
layout(binding=1,rgba8) writeonly uniform image2D outputImage;
layout(push_constant) uniform Params { uvec2 inputSize; float sharpness; } params;
#define FSR_RCAS_F 1
AF4 FsrRcasLoadF(ASU2 p) { return texelFetch(sourceImage,clamp(p,ivec2(0),textureSize(sourceImage,0)-1),0); }
void FsrRcasInputF(inout AF1 r,inout AF1 g,inout AF1 b) {}
#include "fsr/ffx_fsr1.h"
void main() {
    uvec2 pos=gl_GlobalInvocationID.xy;
    if(any(greaterThanEqual(pos,uvec2(imageSize(outputImage))))) return;
    uvec4 con;
    FsrRcasCon(con,2.0*(1.0-clamp(params.sharpness,0.0,1.0)));
    vec3 color;
    FsrRcasF(color.r,color.g,color.b,pos,con);
    imageStore(outputImage,ivec2(pos),vec4(color,1.0));
}
